#: financial_bot/handlers/adding_data.py:27
msgid "Please, select data type"
msgstr "Пожалуйста, выберите тип данных."

#: financial_bot/handlers/adding_data.py:37 financial_bot/keyboards/reply.py:25
msgid "monthly planned budget"
msgstr "месячный планируемый бюджет"

#: financial_bot/handlers/adding_data.py:38
msgid "Enter your estimated monthly planned budget"
msgstr "Введите свой предполагаемый месячный планируемый бюджет"

#: financial_bot/handlers/adding_data.py:41 financial_bot/keyboards/reply.py:26
msgid "limit expense"
msgstr "лимит расходов"

#: financial_bot/handlers/adding_data.py:44
#: financial_bot/handlers/adding_data.py:85
msgid "Enter the spending limit amount"
msgstr "Введите сумму лимита расходов"

#: financial_bot/handlers/adding_data.py:47
#: financial_bot/handlers/adding_data.py:55
msgid "Please set a monthly planned budget first."
msgstr "Пожалуйста, сначала установите планируемый месячный бюджет"

#: financial_bot/handlers/adding_data.py:49 financial_bot/keyboards/reply.py:27
msgid "savings goal"
msgstr "цель сбережений"

#: financial_bot/handlers/adding_data.py:52
msgid "Enter your desired savings amount"
msgstr "Введите желаемую сумму сбережений"

#: financial_bot/handlers/adding_data.py:59
#: financial_bot/handlers/fallback.py:13
msgid "Sorry, I didn't understand you, please use the suggested choice!"
msgstr ""
"Извините, я вас не понял, пожалуйста,"
" воспользуйтесь предложенным вариантом!"
#: financial_bot/handlers/adding_data.py:89
#: financial_bot/handlers/adding_data.py:132
#: financial_bot/handlers/adding_data.py:172
msgid "The data was saved successfully."
msgstr "Данные были успешно сохранены."

#: financial_bot/handlers/adding_data.py:93
msgid "Please, enter a number!"
msgstr "Введите, пожалуйста, сумму!"

#: financial_bot/handlers/adding_data.py:95
#: financial_bot/handlers/adding_data.py:138
#: financial_bot/handlers/adding_data.py:178
msgid "Profile not found. Please type /start"
msgstr "Профиль не найден. Пожалуйста, введите /start"

#: financial_bot/handlers/adding_data.py:111
#: financial_bot/handlers/adding_data.py:154
msgid "You don't have a planned budget set! Set a basic planned budget first."
msgstr ""
"У вас нет установленного планируемого "
"бюджета! Сначала установите базовый бюджет."

#: financial_bot/handlers/ai_consultant.py:30
msgid "Please, select request!"
msgstr "Пожалуйста, выберите запрос!"

#: financial_bot/handlers/ai_consultant.py:36
msgid "Sorry, you need a PRO subscription to use AI."
msgstr "Извините, для использования ИИ вам нужна подписка PRO."

#: financial_bot/handlers/ai_consultant.py:43
msgid "Please send me a photo of the receipt!"
msgstr "Пожалуйста, пришлите мне фотографию чека!"

#: financial_bot/handlers/ai_consultant.py:84
msgid "Please tell us or write about your purchases!"
msgstr "Пожалуйста, расскажите или напишите нам о своих покупках"

#: financial_bot/handlers/ai_consultant.py:92
#: financial_bot/handlers/ai_consultant.py:140
msgid "🧠 I am analyzing your expenses..."
msgstr "🧠 Анализирую ваши расходы..."

#: financial_bot/handlers/ai_consultant.py:99
msgid ""
"❌ The voice message is too long. Please dictate a shorter message (up to "
"30 seconds).."
msgstr "❌ Голосовое сообщение слишком длинное. Пожалуйста, запишите сообщение покороче (до 30 секунд)."

#: financial_bot/handlers/ai_consultant.py:123
msgid ""
"⏳ Background analysis started. I’ll send the result in a couple of "
"seconds; in the meantime, you can continue working:"
msgstr ""
"⏳ Запущен фоновый анализ. Результат "
"будет готов через пару секунд,а пока "
"вы можете продолжать работу:"

#: financial_bot/handlers/ai_consultant.py:130
msgid "❌ Unable to process the voice message. Please try again."
msgstr ""
"❌ Не удалось обработать голосовое "
"сообщение. Пожалуйста, попробуйте еще раз."

#: financial_bot/handlers/ai_consultant.py:161
msgid "❌ The record has been cancelled and removed from the database."
msgstr "❌ Запись аннулирована и удалена из базы данных."

#: financial_bot/handlers/ai_consultant.py:163
msgid "Record not found."
msgstr "Запись не найдена."

#: financial_bot/handlers/common.py:38
#, python-brace-format
